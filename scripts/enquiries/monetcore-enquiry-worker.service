[Unit]
Description=Monetcore private enquiry notification queue
After=network.target
[Service]
Type=oneshot
DynamicUser=yes
User=monetcore_enquiry_worker
WorkingDirectory=@RELEASE@
ExecStart=@NODE@ @RELEASE@/enquiry-worker-start.cjs
Environment=MONETCORE_CONTACT_ENABLED=false
Environment=MONETCORE_CONTACT_PROXY_VERIFIED=false
LoadCredential=enquiry-db-password:/etc/monetcore/enquiries/db-password
LoadCredential=enquiry-smtp-password:/etc/monetcore/enquiries/smtp-password
TimeoutStartSec=480
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
IPAddressDeny=any
IPAddressAllow=localhost
# Commissioning must separately add verified Private Email destination IPs here.
# Keep DNS to the local system resolver; never grant arbitrary Internet egress.
MemoryMax=256M
TasksMax=64
UMask=0077
