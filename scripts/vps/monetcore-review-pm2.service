[Unit]
Description=Isolated Monetcore review PM2 daemon (never production)
After=network.target

[Service]
Type=forking
User=monetcore_review_runtime
Group=monetcore_review_runtime
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=PM2_HOME=/var/lib/monetcore-review-runtime/.pm2
Environment=HOME=/var/lib/monetcore-review-runtime
PIDFile=/var/lib/monetcore-review-runtime/.pm2/pm2.pid
ExecStart=/usr/bin/env -i PATH=/usr/local/bin:/usr/bin:/bin HOME=/var/lib/monetcore-review-runtime PM2_HOME=/var/lib/monetcore-review-runtime/.pm2 /usr/local/libexec/monetcore-review-pm2-start
ExecStop=/usr/bin/env -i PATH=/usr/local/bin:/usr/bin:/bin HOME=/var/lib/monetcore-review-runtime PM2_HOME=/var/lib/monetcore-review-runtime/.pm2 /usr/bin/pm2 kill
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/monetcore-review-runtime /srv/monetcore-review-deploy/releases
ProtectProc=invisible
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
UMask=0077
IPAddressDeny=any
IPAddressAllow=localhost
CPUQuota=50%
MemoryMax=1G
TasksMax=128

[Install]
WantedBy=multi-user.target
