[Unit]
Description=Verify and restore the approved Monetcore review pair
Requires=monetcore-review-pm2.service
BindsTo=monetcore-review-pm2.service
PartOf=monetcore-review-pm2.service
After=monetcore-review-pm2.service nginx.service network-online.target
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=oneshot
User=root
Group=root
RemainAfterExit=yes
ExecStart=/usr/bin/env -i PATH=/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin LANG=C.UTF-8 /usr/local/libexec/monetcore-review-deploy boot-restore
TimeoutStartSec=360
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true
RestrictSUIDSGID=true
IPAddressDeny=any
IPAddressAllow=localhost
UMask=0077
